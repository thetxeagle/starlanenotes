{
  "name": "starlane-notes",
  "version": "1.5.6",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:isolated": "npm run dev --workspace=apps/web -- --host 127.0.0.1 --port 5199 --strictPort",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "validate:design": "node scripts/validate-starlane-design.mjs --public-contributor",
    "validate:notifications": "node scripts/validate-notification-contract.mjs",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "test": "npm run test --workspace=apps/web",
    "desktop:dev": "cd apps/desktop/src-tauri && cargo tauri dev",
    "desktop:build": "cd apps/desktop/src-tauri && cargo tauri build",
    "desktop:build:app": "cd apps/desktop/src-tauri && cargo tauri build --bundles app",
    "env:jwt-secret": "node scripts/generate-jwt-secret.mjs",
    "env:write-jwt-secret": "node scripts/generate-jwt-secret.mjs --write"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "axe-core": "4.10.2",
    "playwright": "1.52.0"
  }
}
