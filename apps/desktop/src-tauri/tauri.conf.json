{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Starlane Notes",
  "version": "1.3.0",
  "identifier": "dev.starlane.notes",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd \"$(git rev-parse --show-toplevel)\" && npm run dev --workspace=apps/web",
    "beforeBuildCommand": "cd \"$(git rev-parse --show-toplevel)\" && npm run build --workspace=apps/web"
  },
  "app": {
    "windows": [
      {
        "title": "Starlane Notes",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$DOCUMENT/**",
          "$HOME/Library/Mobile Documents/**",
          "$HOME/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["starlane"], "appLink": false }],
      "desktop": {
        "schemes": ["starlane"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2RUVFQzY5MDE1OUJEQTgKUldTb3ZWa0JhZXp1NXA3cUYwUGs0bEp3S21OT0VQOXBoZ1h1Tkozd295OFlabldwUG90TnNFMkMK",
      "endpoints": [
        "https://gitea.2eagles.xyz/hft-applications/StarlaneNotes/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
