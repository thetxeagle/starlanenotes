{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Starlane Notes",
  "version": "1.5.6",
  "identifier": "dev.starlane.notes",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd \"$(git rev-parse --show-toplevel)\" && npm run dev --workspace=apps/web",
    "beforeBuildCommand": "cd \"$(git rev-parse --show-toplevel)\" && npm run build --workspace=apps/web"
  },
  "app": {
    "windows": [
      {
        "title": "Starlane Notes",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$DOCUMENT/**",
          "$HOME/Library/Mobile Documents/**",
          "$HOME/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "starlane"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "starlane"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
