# ============================================================
# Starlane Notes Configuration
# Default SQLite template. Copy this file to .env beside docker-compose.yml.
# For the PostgreSQL example, copy .env.postgres.example instead.
# ============================================================

# ----- Core -----
# Container image to pull. Pin a version or image digest for production upgrades.
STARLANE_IMAGE=ghcr.io/hbftechnologies/starlanenotes:latest

# Set to "production" to enforce JWT_SECRET, strict CORS, and CSP headers
STARLANE_ENV=production

# Base URL of your Starlane Notes instance (used for CORS, OAuth callbacks, public links)
BASE_URL=http://localhost:9320

# Optional comma-separated extra production CORS origins.
# Built-in Tauri app origins are allowed automatically for native desktop/mobile clients.
STARLANE_CORS_ORIGINS=

# Optional comma-separated extra origins allowed for passkey/WebAuthn verification.
STARLANE_WEBAUTHN_ORIGINS=

# Data directory for documents, attachments, and search index
DATA_DIR=/data

# Server port
PORT=3000

# Logging level (trace, debug, info, warn, error)
RUST_LOG=starlane_notes_server=info

# ----- Database -----
# SQLite is the default. The server creates /data/starlane-notes.db automatically.
SQLITE_ENABLED=true

# PostgreSQL settings are inactive while SQLite is enabled. Use .env.postgres.example with
# docker-compose.postgres.yml for a complete runnable example.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=starlane
POSTGRES_PASSWORD=
POSTGRES_DB=starlane_notes
POSTGRES_SSLMODE=disable

# Optional legacy override for PostgreSQL only. Ignored when SQLITE_ENABLED=true.
DATABASE_URL=

# ----- Authentication -----
# JWT secret key. Production startup refuses an empty or short value.
# Write one into .env with:
#   JWT_SECRET="$(openssl rand -hex 32)"
#   sed -i.bak "s/^JWT_SECRET=.*/JWT_SECRET=${JWT_SECRET}/" .env
#   rm -f .env.bak
JWT_SECRET=

# Keep public registration disabled for invite-only/self-hosted deployments.
ALLOW_PUBLIC_SIGNUPS=false

# ----- OAuth2: Google -----
# Login button hidden in UI if not set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- OAuth2: GitHub -----
# Login button hidden in UI if not set
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----- OIDC (Bring Your Own) -----
OIDC_ENABLED=false
OIDC_DISPLAY_NAME=SSO
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid,profile,email
OIDC_USER_CLAIM=email
OIDC_ROLE_CLAIM=
OIDC_ROLE_ADMIN_VALUE=admin
OIDC_AUTO_PROVISION=true

# ----- User Provisioning Policy -----
# Optional comma-separated allowlists for admin invite/CSV user provisioning.
# Empty domains means any email domain is allowed.
USER_PROVISIONING_ALLOWED_EMAIL_DOMAINS=
USER_PROVISIONING_ALLOWED_ROLES=admin,member,viewer

# ----- 2FA -----
# Enforce 2FA for all users
REQUIRE_2FA=false

# ----- Email (SMTP) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# ----- AI Integration -----
AI_ENABLED=false
# Providers: ollama, openai, anthropic, xai
AI_DEFAULT_PROVIDER=ollama

# Ollama (local/self-hosted)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# xAI (Grok)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-2-latest

# ----- Storage -----
# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=100

# ----- Public Pages -----
# Allow documents to be published as public read-only pages
ALLOW_PUBLIC_PAGES=true
