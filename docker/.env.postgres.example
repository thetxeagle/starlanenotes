# ============================================================
# Starlane Notes + PostgreSQL Configuration
# Copy this file to .env beside docker-compose.postgres.yml.
# Generate JWT_SECRET and POSTGRES_PASSWORD before first start.
# ============================================================

# Pin a version or image digest for controlled production upgrades.
STARLANE_IMAGE=ghcr.io/hbftechnologies/starlanenotes:latest

STARLANE_ENV=production
BASE_URL=http://localhost:9320
STARLANE_CORS_ORIGINS=
STARLANE_WEBAUTHN_ORIGINS=
DATA_DIR=/data
PORT=3000
RUST_LOG=starlane_notes_server=info

# PostgreSQL is private to the Compose network. The hostname matches the service name in
# docker-compose.postgres.yml. Do not set DATABASE_URL unless you intentionally want it to
# override these split values.
SQLITE_ENABLED=false
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=starlane
POSTGRES_PASSWORD=
POSTGRES_DB=starlane_notes
POSTGRES_SSLMODE=disable
DATABASE_URL=

# Both values must be generated before first start. Hex output avoids .env escaping surprises.
#   JWT_SECRET="$(openssl rand -hex 32)"
#   POSTGRES_PASSWORD="$(openssl rand -hex 32)"
#   sed -i.bak \
#     -e "s/^JWT_SECRET=.*/JWT_SECRET=${JWT_SECRET}/" \
#     -e "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=${POSTGRES_PASSWORD}/" .env
#   rm -f .env.bak
JWT_SECRET=

# Safer defaults for a new production deployment.
ALLOW_PUBLIC_SIGNUPS=false
REQUIRE_2FA=false
ALLOW_PUBLIC_PAGES=true
MAX_UPLOAD_SIZE_MB=100
